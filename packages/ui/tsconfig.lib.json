{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Shared base keeps `preserve` for Next; this package is a component
    // library consumed by other bundlers/tests, so it uses the automatic
    // React 19 runtime.
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.config.ts"]
}
