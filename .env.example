# OmniDoc — web placeholders (S-01a)
#
# Copy to `.env.local` for local runs. NEVER commit real keys, BYOK
# material, or `.env.local` contents. Production AI remains gated
# (mock-first); these placeholders carry no secrets.

# Public base URL of the web app (local dev default).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the JVM API (S-01b health endpoint; not present yet).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Runtime mode label near Ask (ADR-0004): mock | operator_free_tier | customer_key.
# S-01a scaffold default is mock. Live modes stay forbidden until the CX gate closes.
NEXT_PUBLIC_RUNTIME_MODE=mock

# Corpus label default for the portfolio demo path (sample vs mine).
NEXT_PUBLIC_CORPUS_LABEL=mine
